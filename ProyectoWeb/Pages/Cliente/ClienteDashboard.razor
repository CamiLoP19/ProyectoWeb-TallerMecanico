@page "/cliente"
@attribute [Authorize(Roles = "Cliente")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@layout EmptyLayout
@inject NavigationManager Navigation
@inject ILogger<ClienteDashboard> Logger

<PageTitle>Panel de Cliente</PageTitle>

<div class="cliente-wrapper">

    <!-- Header -->
    <header class="header-bar d-flex justify-content-between align-items-center px-4">
        <div class="d-flex align-items-center">
            <i class="fas fa-user-circle icon-title me-3"></i>
            <h1 class="header-title mb-0">Panel de Cliente</h1>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-items-center">
                    <span class="user-name me-3">@context.User.Identity?.Name</span>

                    <button class="btn btn-outline-light btn-sm" @onclick="CerrarSesion">
                        <i class="fas fa-sign-out-alt me-1"></i>Cerrar sesión
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <!-- Contenido -->
    <main class="container py-5">

        <p class="text-center welcome-text mb-5">
            Bienvenido a tu panel de cliente
        </p>

        <div class="row g-4 justify-content-center">

            <!-- Solicitudes -->
            <div class="col-md-4">
                <div class="card-panel border-start border-4 border-warning">
                    <div class="card-content">
                        <div>
                            <h3 class="card-title">Mis Solicitudes</h3>
                            <p class="card-subtitle">Ver estado</p>
                        </div>
                        <i class="fas fa-clipboard-list card-icon"></i>
                    </div>

                    <p class="card-text">
                        Consulta el estado de tus solicitudes de servicio.
                    </p>

                    <button class="btn-action" @onclick='() => Navigation.NavigateTo("/cliente/mis-solicitudes")'>
                        <span>Ver solicitudes</span>
                        <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>

            <!-- Facturas -->
            <div class="col-md-4">
                <div class="card-panel border-start border-4 border-info">
                    <div class="card-content">
                        <div>
                            <h3 class="card-title">Mis Facturas</h3>
                            <p class="card-subtitle">Ver facturas</p>
                        </div>
                        <i class="fas fa-file-invoice-dollar card-icon"></i>
                    </div>

                    <p class="card-text">
                        Consulta tus facturas, pagos realizados y saldos pendientes.
                    </p>

                    <button class="btn-action" @onclick='() => Navigation.NavigateTo("/cliente/facturas")'>
                        <span>Ver mis facturas</span>
                        <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>

            <!-- Abonar -->
            <div class="col-md-4">
                <div class="card-panel border-start border-4 border-success">
                    <div class="card-content">
                        <div>
                            <h3 class="card-title">Abonar</h3>
                            <p class="card-subtitle">Realizar pago</p>
                        </div>
                        <i class="fas fa-money-bill-wave card-icon"></i>
                    </div>

                    <p class="card-text">
                        Realiza pagos parciales o totales a tus facturas pendientes.
                    </p>

                    <button class="btn-action" @onclick='() => Navigation.NavigateTo("/cliente/abonar")'>
                        <span>Hacer abono</span>
                        <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>

        </div>

    </main>

</div>

<style>

    /* Fondo general */
    .cliente-wrapper {
        background: #eef2f5;
        min-height: 100vh;
    }

    /* ===== HEADER ===== */
    .header-bar {
        height: 70px;
        background: #0d3b48;
        border-bottom: 3px solid #0b2f38;
        color: white;
    }

    .header-title {
        font-size: 1.6rem;
        font-weight: 700;
    }

    .icon-title {
        font-size: 2rem;
    }

    .user-name {
        font-weight: 600;
        color: #dff7ff;
    }

    /* ===== CONTENIDO ===== */
    .welcome-text {
        font-size: 1.2rem;
        font-weight: 600;
        color: #12333d;
    }

    /* ===== TARJETAS ===== */
    .card-panel {
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0px 4px 10px rgba(0,0,0,0.08);
        transition: 0.2s ease;
    }

    .card-panel:hover {
        transform: translateY(-6px);
        box-shadow: 0px 8px 18px rgba(0,0,0,0.12);
    }

    .card-title {
        font-size: 1.4rem;
        font-weight: 700;
        margin-bottom: 5px;
        color: #1a1e21;
    }

    .card-subtitle {
        font-size: .95rem;
        color: #6c757d;
    }

    .card-text {
        margin-top: 10px;
        margin-bottom: 22px;
        color: #4d555a;
    }

    .card-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-icon {
        font-size: 2.8rem;
        color: #adb5bd;
    }

    .btn-action {
        width: 100%;
        background: #f8f9fa;
        border: 1px solid #ced4da;
        padding: 10px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .btn-action:hover {
        background: #e9ecef;
        transform: scale(1.03);
    }

</style>

@code {
    private void CerrarSesion()
    {
        Navigation.NavigateTo("/logoutpage", true);
    }
}
