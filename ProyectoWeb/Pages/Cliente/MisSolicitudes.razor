@page "/cliente/mis-solicitudes"
@attribute [Authorize(Roles = "Cliente")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ProyectoWeb.Models
@layout EmptyLayout
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<MisSolicitudes> Logger

<PageTitle>Mis Solicitudes</PageTitle>

<div class="page-wrapper">

    <!-- HEADER PROFESIONAL -->
    <header class="header-bar d-flex justify-content-between align-items-center px-4">
        <div class="d-flex align-items-center">
            <button class="btn btn-outline-light btn-sm me-3" @onclick='() => Navigation.NavigateTo("/cliente")'>
                <i class="fas fa-arrow-left me-2"></i>Volver
            </button>

            <h1 class="header-title mb-0">
                <i class="fas fa-list-alt me-2"></i> Mis Solicitudes
            </h1>
        </div>

        <button class="btn btn-primary btn-sm" @onclick='() => Navigation.NavigateTo("/cliente/solicitar-servicio")'>
            <i class="fas fa-plus me-2"></i> Nueva Solicitud
        </button>
    </header>

    <!-- CONTENIDO -->
    <div class="container py-5">

        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                <p class="mt-3 text-muted">Cargando solicitudes...</p>
            </div>
        }
        else if (solicitudes == null || !solicitudes.Any())
        {
            <div class="card empty-card mx-auto text-center p-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h4 class="mb-2">No tienes solicitudes</h4>
                <p class="text-muted">Realiza una solicitud para comenzar</p>

                <button class="btn btn-primary mt-3" @onclick='() => Navigation.NavigateTo("/cliente/solicitar-servicio")'>
                    <i class="fas fa-plus me-2"></i> Solicitar Servicio
                </button>
            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var solicitud in solicitudes.OrderByDescending(s => s.FechaSolicitud))
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="solicitud-card shadow-sm">

                            <!-- HEADER DEL ESTADO -->
                            <div class="estado-header @GetEstadoClass(solicitud.EstadoSolicitud)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="estado-codigo">#@solicitud.Id?.Substring(0, 8)</span>
                                    <span class="badge bg-light text-dark">@GetEstadoTexto(solicitud.EstadoSolicitud)</span>
                                </div>
                            </div>

                            <div class="card-body">

                                <h5 class="solicitud-titulo">@solicitud.ServicioNombre</h5>

                                <p class="card-info">
                                    <i class="fas fa-calendar-alt me-2 text-primary"></i>
                                    <strong>Fecha:</strong> @solicitud.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </p>

                                @if (solicitud.EmpleadoNombre != null)
                                {
                                    <p class="card-info">
                                        <i class="fas fa-user-tie me-2 text-success"></i>
                                        <strong>Empleado:</strong> @solicitud.EmpleadoNombre
                                    </p>
                                }

                                <p class="card-info mb-1">
                                    <i class="fas fa-align-left me-2 text-secondary"></i>
                                    <strong>Descripción:</strong>
                                </p>
                                <p class="descripcion-text">@solicitud.Descripcion</p>

                                @if (!string.IsNullOrEmpty(solicitud.Detalle))
                                {
                                    <p class="card-info mb-1 mt-3">
                                        <i class="fas fa-info-circle me-2 text-warning"></i>
                                        <strong>Detalles:</strong>
                                    </p>
                                    <p class="detalle-text">@solicitud.Detalle</p>
                                }

                                <!-- Alertas -->
                                @if (solicitud.EstadoSolicitud == EstadoSolicitud.Completada && solicitud.FechaCompletada.HasValue)
                                {
                                    <div class="alert alert-success mt-3">
                                        <i class="fas fa-check-circle me-2"></i>
                                        Completado el @solicitud.FechaCompletada.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                    </div>
                                }
                                else if (solicitud.EstadoSolicitud == EstadoSolicitud.EnProceso)
                                {
                                    <div class="alert alert-info mt-3">
                                        <i class="fas fa-cog fa-spin me-2"></i>
                                        En proceso...
                                    </div>
                                }
                            </div>

                        </div>
                    </div>
                }

            </div>
        }
    </div>

</div>

<style>

    /* ===== GENERAL ===== */
    .page-wrapper {
        background: #eef2f5;
        min-height: 100vh;
    }

    /* ===== HEADER ===== */
    .header-bar {
        height: 70px;
        background: #0d3b48;
        border-bottom: 3px solid #0b2f38;
        color: white;
    }

    .header-title {
        font-size: 1.5rem;
        font-weight: 700;
    }

    /* ===== ESTADOS ===== */
    .estado-header {
        padding: 12px;
        font-size: 0.9rem;
        color: white;
        font-weight: 600;
    }

    .estado-codigo {
        background: rgba(0,0,0,0.2);
        padding: 3px 8px;
        border-radius: 5px;
        font-size: 0.8rem;
    }

    .estado-pendiente {
        background: #ff9800;
    }

    .estado-enproceso {
        background: #1976d2;
    }

    .estado-completada {
        background: #2e7d32;
    }

    .estado-cancelada {
        background: #d32f2f;
    }

    /* ===== TARJETAS ===== */
    .solicitud-card {
        background: white;
        border-radius: 10px;
        transition: 0.2s ease;
        border: 1px solid #d7d8da;
    }

    .solicitud-card:hover {
        transform: translateY(-5px);
        box-shadow: 0px 6px 18px rgba(0,0,0,0.12);
    }

    .solicitud-titulo {
        font-weight: 700;
        margin-bottom: 10px;
        color: #1b1f22;
    }

    .card-info {
        font-size: 0.95rem;
        margin-bottom: 5px;
        color: #333;
    }

    .descripcion-text,
    .detalle-text {
        font-size: 0.85rem;
        color: #555;
        background: #f7f7f7;
        padding: 8px;
        border-radius: 5px;
        border: 1px solid #e1e1e1;
    }

    /* Tarjeta vacía */
    .empty-card {
        max-width: 450px;
        border-radius: 12px;
    }

</style>

@code {
    private List<SolicitudServicio>? solicitudes;
    private bool cargando = true;
    private string? clienteId;

    protected override async Task OnInitializedAsync()
    {
        await ObtenerClienteId();
        await CargarSolicitudes();
    }

    private async Task ObtenerClienteId()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                clienteId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                Logger.LogInformation($"Cliente ID: {clienteId}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al obtener ID del cliente");
        }
    }

    private async Task CargarSolicitudes()
    {
        try
        {
            cargando = true;
            var response = await Http.GetAsync("api/solicitud");

            if (response.IsSuccessStatusCode)
            {
                var todasLasSolicitudes = await response.Content.ReadFromJsonAsync<List<SolicitudServicio>>();
                solicitudes = todasLasSolicitudes?.Where(s => s.ClienteId == clienteId).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar solicitudes");
        }
        finally
        {
            cargando = false;
        }
    }

    private string GetEstadoClass(EstadoSolicitud estado)
    {
        return estado switch
        {
            EstadoSolicitud.Pendiente => "estado-pendiente",
            EstadoSolicitud.EnProceso => "estado-enproceso",
            EstadoSolicitud.Completada => "estado-completada",
            EstadoSolicitud.Cancelada => "estado-cancelada",
            _ => "estado-pendiente"
        };
    }

    private string GetEstadoTexto(EstadoSolicitud estado)
    {
        return estado switch
        {
            EstadoSolicitud.Pendiente => "Pendiente",
            EstadoSolicitud.EnProceso => "En Proceso",
            EstadoSolicitud.Completada => "Completada",
            EstadoSolicitud.Cancelada => "Cancelada",
            _ => "Desconocido"
        };
    }
}
