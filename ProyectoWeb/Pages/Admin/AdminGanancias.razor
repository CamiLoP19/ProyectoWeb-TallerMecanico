@page "/admin/ganancias"
@using ProyectoWeb.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Authorization
@inject GananciaService GananciaService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Administrador")]
@layout EmptyLayout

<div class="container-fluid min-vh-100 bg-light py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-11">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold text-primary mb-1">
                        <i class="bi bi-graph-up-arrow"></i> Reporte de Ganancias
                    </h2>
                    <p class="text-muted mb-0">Análisis financiero del taller</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-success no-print" @onclick="ImprimirReporte">
                        <i class="bi bi-printer"></i> Imprimir
                    </button>
                    <button class="btn btn-outline-secondary no-print" @onclick="Volver">
                        <i class="bi bi-arrow-left"></i> Volver
                    </button>
                </div>
            </div>

            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 text-muted">Cargando reporte...</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> @errorMessage
                </div>
            }
            else if (reporte != null)
            {
                <!-- Filtro de Fecha -->
                <div class="card shadow-sm mb-4 no-print">
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Mes</label>
                                <select class="form-select" @bind="mesSeleccionado">
                                    <option value="0">📅 Todo el Año</option>
                                    <option value="1">Enero</option>
                                    <option value="2">Febrero</option>
                                    <option value="3">Marzo</option>
                                    <option value="4">Abril</option>
                                    <option value="5">Mayo</option>
                                    <option value="6">Junio</option>
                                    <option value="7">Julio</option>
                                    <option value="8">Agosto</option>
                                    <option value="9">Septiembre</option>
                                    <option value="10">Octubre</option>
                                    <option value="11">Noviembre</option>
                                    <option value="12">Diciembre</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Año</label>
                                <select class="form-select" @bind="anioSeleccionado">
                                    @for (int i = DateTime.Now.Year; i >= DateTime.Now.Year - 5; i--)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <button class="btn btn-primary w-100" @onclick="CargarReporte">
                                    <i class="bi bi-search"></i> Consultar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @if (reporte.TotalFacturas == 0)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        <strong>No hay datos para el período seleccionado.</strong><br/>
                        No se encontraron facturas para @(mesSeleccionado == 0 ? "el año " + anioSeleccionado : ObtenerNombreMes(mesSeleccionado) + " de " + anioSeleccionado).
                        Intenta seleccionar otro período o genera facturas primero.
                    </div>
                }
                else
                {
                    <!-- Tarjetas de Resumen -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0 h-100" style="background-color: white !important;">
                                <div class="card-body text-center" style="background-color: white !important;">
                                    <div class="text-primary mb-2" style="font-size: 2.5rem;">
                                        <i class="bi bi-receipt"></i>
                                    </div>
                                    <h6 class="text-muted text-uppercase small mb-2">Total Facturas</h6>
                                    <h2 class="fw-bold mb-1">@reporte.TotalFacturas</h2>
                                    <small class="text-success fw-bold">@reporte.FacturasPagadas pagadas</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0 h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
                                <div class="card-body text-center text-white" style="background: transparent !important;">
                                    <div class="mb-2" style="font-size: 2.5rem;">
                                        <i class="bi bi-tools"></i>
                                    </div>
                                    <h6 class="text-white text-uppercase small mb-2">Servicios</h6>
                                    <h2 class="fw-bold mb-0 text-white">@reporte.GananciaServicios.ToString("C2")</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0 h-100" style="background-color: #28a745 !important;">
                                <div class="card-body text-center text-white" style="background: transparent !important;">
                                    <div class="mb-2" style="font-size: 2.5rem;">
                                        <i class="bi bi-box-seam"></i>
                                    </div>
                                    <h6 class="text-white text-uppercase small mb-2">Productos</h6>
                                    <h2 class="fw-bold mb-0 text-white">@reporte.GananciaProductos.ToString("C2")</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0 h-100" style="background-color: #ffc107 !important;">
                                <div class="card-body text-center" style="background: transparent !important;">
                                    <div class="text-dark mb-2" style="font-size: 2.5rem;">
                                        <i class="bi bi-person-check"></i>
                                    </div>
                                    <h6 class="text-dark text-uppercase small mb-2">Comisiones</h6>
                                    <h2 class="fw-bold mb-0 text-dark">@reporte.ComisionEmpleado.ToString("C2")</h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ganancias Totales -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="card shadow border-0 h-100" style="border-left: 6px solid #28a745 !important; background: linear-gradient(135deg, #f8fff9 0%, #e8f5e9 100%);">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                            <i class="bi bi-cash-stack text-success" style="font-size: 2rem;"></i>
                                        </div>
                                        <div>
                                            <h6 class="text-success text-uppercase small mb-1 fw-bold">Ingreso Total</h6>
                                            <p class="text-muted small mb-0">Servicios + Productos</p>
                                        </div>
                                    </div>
                                    <h1 class="fw-bold text-success mb-0" style="font-size: 2.5rem;">@reporte.TotalGanado.ToString("C2")</h1>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card shadow border-0 h-100" style="border-left: 6px solid #007bff !important; background: linear-gradient(135deg, #f0f7ff 0%, #e3f2fd 100%);">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                            <i class="bi bi-trophy text-primary" style="font-size: 2rem;"></i>
                                        </div>
                                        <div>
                                            <h6 class="text-primary text-uppercase small mb-1 fw-bold">Ganancia Neta</h6>
                                            <p class="text-muted small mb-0">Total - Comisiones</p>
                                        </div>
                                    </div>
                                    <h1 class="fw-bold text-primary mb-0" style="font-size: 2.5rem;">@reporte.GananciaNeta.ToString("C2")</h1>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Gráficas CSS -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <div class="card shadow border-0 h-100">
                                <div class="card-header bg-white border-bottom py-3">
                                    <h5 class="mb-0 fw-bold text-dark">
                                        <i class="bi bi-bar-chart-fill text-primary"></i> Distribución de Ingresos
                                    </h5>
                                </div>
                                <div class="card-body bg-white p-4">
                                    @{
                                        var maxValue = Math.Max(Math.Max((double)reporte.GananciaServicios, (double)reporte.GananciaProductos), 
                                                               Math.Max((double)reporte.ComisionEmpleado, (double)reporte.GananciaNeta));
                                    }
                                    <div class="chart-bars">
                                        <!-- Servicios -->
                                        <div class="mb-4">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="fw-bold"><i class="bi bi-tools text-primary"></i> Servicios</span>
                                                <span class="fw-bold text-primary">@reporte.GananciaServicios.ToString("C2")</span>
                                            </div>
                                            <div class="progress" style="height: 30px;">
                                                <div class="progress-bar bg-primary" style="width: @(((double)reporte.GananciaServicios / maxValue * 100).ToString("F1"))%">
                                                    @(((double)reporte.GananciaServicios / reporte.TotalGanado * 100).ToString("F1"))%
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Productos -->
                                        <div class="mb-4">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="fw-bold"><i class="bi bi-box-seam text-success"></i> Productos</span>
                                                <span class="fw-bold text-success">@reporte.GananciaProductos.ToString("C2")</span>
                                            </div>
                                            <div class="progress" style="height: 30px;">
                                                <div class="progress-bar bg-success" style="width: @(((double)reporte.GananciaProductos / maxValue * 100).ToString("F1"))%">
                                                    @(((double)reporte.GananciaProductos / reporte.TotalGanado * 100).ToString("F1"))%
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Comisiones -->
                                        <div class="mb-4">
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="fw-bold"><i class="bi bi-person-check text-warning"></i> Comisiones</span>
                                                <span class="fw-bold text-warning">@reporte.ComisionEmpleado.ToString("C2")</span>
                                            </div>
                                            <div class="progress" style="height: 30px;">
                                                <div class="progress-bar bg-warning" style="width: @(((double)reporte.ComisionEmpleado / maxValue * 100).ToString("F1"))%">
                                                    @(((double)reporte.ComisionEmpleado / reporte.TotalGanado * 100).ToString("F1"))%
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Ganancia Neta -->
                                        <div>
                                            <div class="d-flex justify-content-between mb-2">
                                                <span class="fw-bold"><i class="bi bi-trophy text-info"></i> Ganancia Neta</span>
                                                <span class="fw-bold text-info">@reporte.GananciaNeta.ToString("C2")</span>
                                            </div>
                                            <div class="progress" style="height: 30px;">
                                                <div class="progress-bar bg-info" style="width: @(((double)reporte.GananciaNeta / maxValue * 100).ToString("F1"))%">
                                                    @(((double)reporte.GananciaNeta / reporte.TotalGanado * 100).ToString("F1"))%
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card shadow border-0 h-100">
                                <div class="card-header bg-white border-bottom py-3">
                                    <h5 class="mb-0 fw-bold text-dark">
                                        <i class="bi bi-pie-chart-fill text-success"></i> Composición
                                    </h5>
                                </div>
                                <div class="card-body bg-white p-4 d-flex flex-column justify-content-center">
                                    @{
                                        var porcentajeServicios = ((double)reporte.GananciaServicios / reporte.TotalGanado * 100);
                                        var porcentajeProductos = ((double)reporte.GananciaProductos / reporte.TotalGanado * 100);
                                    }
                                    <!-- Gráfico de dona CSS -->
                                    <div class="text-center mb-4">
                                        <div class="position-relative d-inline-block" style="width: 200px; height: 200px;">
                                            <svg viewBox="0 0 200 200" style="transform: rotate(-90deg);">
                                                <!-- Servicios -->
                                                <circle cx="100" cy="100" r="80" fill="none" stroke="#667eea" stroke-width="40"
                                                        stroke-dasharray="@(porcentajeServicios * 5.02655) 502.655"
                                                        stroke-dashoffset="0"></circle>
                                                <!-- Productos -->
                                                <circle cx="100" cy="100" r="80" fill="none" stroke="#28a745" stroke-width="40"
                                                        stroke-dasharray="@(porcentajeProductos * 5.02655) 502.655"
                                                        stroke-dashoffset="-@(porcentajeServicios * 5.02655)"></circle>
                                            </svg>
                                            <div class="position-absolute top-50 start-50 translate-middle text-center">
                                                <div class="fw-bold">Total</div>
                                                <div class="fs-6 fw-bold text-primary">@reporte.TotalGanado.ToString("C2")</div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Leyenda -->
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-3 p-2 rounded" style="background-color: #f0f7ff;">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 20px; height: 20px; background-color: #667eea; border-radius: 4px;" class="me-2"></div>
                                                <span class="fw-bold">Servicios</span>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold text-primary">@porcentajeServicios.ToString("F1")%</div>
                                                <small class="text-muted">@reporte.GananciaServicios.ToString("C2")</small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background-color: #f0fff4;">
                                            <div class="d-flex align-items-center">
                                                <div style="width: 20px; height: 20px; background-color: #28a745; border-radius: 4px;" class="me-2"></div>
                                                <span class="fw-bold">Productos</span>
                                            </div>
                                            <div class="text-end">
                                                <div class="fw-bold text-success">@porcentajeProductos.ToString("F1")%</div>
                                                <small class="text-muted">@reporte.GananciaProductos.ToString("C2")</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Desglose Detallado -->
                    <div class="card shadow border-0">
                        <div class="card-header py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <h5 class="mb-0 text-white fw-bold">
                                <i class="bi bi-table"></i> Desglose Detallado - @(mesSeleccionado == 0 ? "Año " + anioSeleccionado : reporte.NombreMes + " " + reporte.Anio)
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead style="background-color: #f8f9fa;">
                                        <tr>
                                            <th class="py-3 ps-4">Concepto</th>
                                            <th class="text-end py-3">Monto</th>
                                            <th class="text-center py-3 pe-4">% del Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr class="border-bottom">
                                            <td class="py-3 ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3">
                                                        <i class="bi bi-tools text-primary"></i>
                                                    </div>
                                                    <strong>Ingresos por Servicios</strong>
                                                </div>
                                            </td>
                                            <td class="text-end fw-bold text-primary fs-5 py-3">@reporte.GananciaServicios.ToString("C2")</td>
                                            <td class="text-center py-3 pe-4">
                                                <span class="badge bg-primary rounded-pill px-3 py-2">@(((reporte.GananciaServicios / reporte.TotalGanado) * 100).ToString("F1"))%</span>
                                            </td>
                                        </tr>
                                        <tr class="border-bottom">
                                            <td class="py-3 ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-circle bg-success bg-opacity-10 p-2 me-3">
                                                        <i class="bi bi-box-seam text-success"></i>
                                                    </div>
                                                    <strong>Ingresos por Productos</strong>
                                                </div>
                                            </td>
                                            <td class="text-end fw-bold text-success fs-5 py-3">@reporte.GananciaProductos.ToString("C2")</td>
                                            <td class="text-center py-3 pe-4">
                                                <span class="badge bg-success rounded-pill px-3 py-2">@(((reporte.GananciaProductos / reporte.TotalGanado) * 100).ToString("F1"))%</span>
                                            </td>
                                        </tr>
                                        <tr class="bg-light border-bottom">
                                            <td class="py-3 ps-4"><strong class="fs-5">Subtotal Ingresos</strong></td>
                                            <td class="text-end fw-bold fs-4 py-3">@reporte.TotalGanado.ToString("C2")</td>
                                            <td class="text-center py-3 pe-4">
                                                <span class="badge bg-info rounded-pill px-3 py-2">100%</span>
                                            </td>
                                        </tr>
                                        <tr class="border-bottom">
                                            <td class="py-3 ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-circle bg-warning bg-opacity-10 p-2 me-3">
                                                        <i class="bi bi-person-check text-warning"></i>
                                                    </div>
                                                    <strong>Comisiones Empleados</strong>
                                                </div>
                                            </td>
                                            <td class="text-end fw-bold text-warning fs-5 py-3">- @reporte.ComisionEmpleado.ToString("C2")</td>
                                            <td class="text-center py-3 pe-4">
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">@(((reporte.ComisionEmpleado / reporte.TotalGanado) * 100).ToString("F1"))%</span>
                                            </td>
                                        </tr>
                                        <tr style="background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);">
                                            <td class="py-4 ps-4">
                                                <strong class="fs-4">
                                                    <i class="bi bi-trophy-fill text-primary"></i> GANANCIA NETA
                                                </strong>
                                            </td>
                                            <td class="text-end fw-bold text-primary py-4" style="font-size: 1.75rem;">@reporte.GananciaNeta.ToString("C2")</td>
                                            <td class="text-center py-4 pe-4">
                                                <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">@(((reporte.GananciaNeta / reporte.TotalGanado) * 100).ToString("F1"))%</span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }
        
        body {
            background-color: white !important;
        }
        
        .card {
            break-inside: avoid;
            page-break-inside: avoid;
            border: 1px solid #dee2e6 !important;
        }
        
        h2, h3, h5 {
            color: #000 !important;
        }
        
        /* Convertir tarjetas de colores a blanco con borde en impresión */
        .card[style*="gradient"],
        .card[style*="#28a745"],
        .card[style*="#ffc107"] {
            background: white !important;
            border: 2px solid #dee2e6 !important;
        }
        
        .card[style*="gradient"] *,
        .card[style*="#28a745"] *,
        .card[style*="#ffc107"] * {
            color: #000 !important;
        }
    }
</style>

@code {
    private ReporteGanancias? reporte;
    private bool cargando = true;
    private string? errorMessage;
    private int mesSeleccionado = 0; // 0 = Todo el año
    private int anioSeleccionado = DateTime.Now.Year;

    protected override async Task OnInitializedAsync()
    {
        await CargarReporte();
    }

    private async Task CargarReporte()
    {
        try
        {
            cargando = true;
            errorMessage = null;
            
            // Si mesSeleccionado = 0, cargar todo el año, sino cargar mes específico
            if (mesSeleccionado == 0)
            {
                reporte = await GananciaService.ObtenerGananciasPorAnioAsync(anioSeleccionado);
            }
            else
            {
                reporte = await GananciaService.ObtenerGananciasPorMesAsync(mesSeleccionado, anioSeleccionado);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar el reporte: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void ImprimirReporte()
    {
        JSRuntime.InvokeVoidAsync("window.print");
    }

    private void Volver()
    {
        Navigation.NavigateTo("/admin");
    }

    private string ObtenerNombreMes(int mes)
    {
        return mes switch
        {
            1 => "Enero",
            2 => "Febrero",
            3 => "Marzo",
            4 => "Abril",
            5 => "Mayo",
            6 => "Junio",
            7 => "Julio",
            8 => "Agosto",
            9 => "Septiembre",
            10 => "Octubre",
            11 => "Noviembre",
            12 => "Diciembre",
            _ => "Desconocido"
        };
    }
}
