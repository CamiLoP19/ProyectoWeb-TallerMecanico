    {
      "name": "CA003 - Crear Solicitud",
      "item": [
        {
          "name": "CA003 - Crear Solicitud de Servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
