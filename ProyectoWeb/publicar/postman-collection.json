              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitudId\": \"SVC001\",\n  \"detalles\": [\n    {\n      \"productoId\": \"PROD001\",\n      \"cantidad\": 2,\n      \"precioUnitario\": 25000\n    },\n    {\n      \"servicioId\": \"SRV001\",\n      \"descripcion\": \"Cambio de aceite\",\n      \"precio\": 70000\n    }\n  ],\n  \"total\": 120000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/facturas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "facturas"]
            }
          }
        }
      ]
