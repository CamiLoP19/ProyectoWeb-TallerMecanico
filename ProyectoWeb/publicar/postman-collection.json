    {
      "name": "CA004 - Generar Factura",
      "item": [
        {
          "name": "CA004 - Generar Factura",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Factura ID exists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.facturaId).to.exist;",
                  "});",
                  "",
                  "pm.test(\"Total is correct\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.total).to.eql(120000);",
                  "});"
                ],
                "type": "text/javascript"
