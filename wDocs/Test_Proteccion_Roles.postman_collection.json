{
	"info": {
		"name": "Protección Frente a Errores - Test de Roles",
		"description": "Pruebas automatizadas para verificar que cada rol solo puede acceder a sus rutas permitidas. Métrica: 100% = Todos los roles están correctamente restringidos",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Login como Cliente",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Login exitoso\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Guardar cookies para próximas peticiones",
							"pm.cookies.jar().set(\"localhost\", \".AspNetCore.Cookies\", pm.response.headers.get(\"set-cookie\"));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"nombreUsuario\": \"camilos\",\n    \"password\": \"1234\"\n}"
				},
				"url": {
					"raw": "http://localhost:5000/api/auth/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000",
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			}
		},
		{
			"name": "2. Cliente intenta acceder a ruta de Empleado (DEBE FALLAR)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Acceso denegado - Protección funcionando\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([401, 403, 302]);",
							"});",
							"",
							"pm.test(\"Cliente NO puede acceder a rutas de Empleado\", function () {",
							"    pm.expect(pm.response.text()).to.not.include(\"Panel de Empleado\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:5000/empleado",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000",
					"path": [
						"empleado"
					]
				}
			}
		},
